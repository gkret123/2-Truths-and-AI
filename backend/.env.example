# OpenAI API key (required for live mode)
OPENAI_API_KEY=sk-...

# Port the backend server listens on (default: 3001)
PORT=3001

# Session time-to-live in milliseconds (default: 30 minutes)
SESSION_TTL_MS=1800000

# Set to "true" to use pre-built demo rounds instead of calling OpenAI.
# Useful for testing the UI without a real API key.
DEMO_MODE=false
