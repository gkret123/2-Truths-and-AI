# ──────────────────────────────────────────────────────────────
# Two Truths and AI — backend environment
# ──────────────────────────────────────────────────────────────

#IMPORTANT: To make the 

# Mock mode (default) uses scripted AI responses, so the entire
# installation can be exercised end-to-end with no API key.
# Flip this to "false" once you have wired up a real key.
MOCK_AI=false

# OpenAI API key — only required when MOCK_AI=false.
OPENAI_API_KEY=sk... #ADD OPEN-AI API KEY HERE

# Model for the Realtime API voice mode (default: gpt-realtime-mini).
# Upgrade to gpt-realtime-1.5 for the full model later.
OPENAI_MODEL=gpt-realtime-1.5

# Port the backend server listens on (default: 3001)
PORT=3001

# Session time-to-live in milliseconds (default: 30 minutes).
# For a kiosk, consider 600000 (10 min) so sessions clear quickly.
SESSION_TTL_MS=1800000
